# ─── Required ──────────────────────────────────────────────────────────────────
# Get from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Channel (Optional but Recommended) ────────────────────────────────────────
# Your Telegram channel ID or username where notes will be posted
# Examples:
#   @YourChannelUsername
#   -1001234567890  (numeric ID for private channels)
# Leave blank to disable channel posting
CHANNEL_ID=@YourFounderNotesChannel

# ─── Deployment Mode ───────────────────────────────────────────────────────────
# "polling" for local development
# "webhook" for Render production
RUN_MODE=polling

# ─── Webhook (Only needed for Render/production) ───────────────────────────────
# Your Render app URL, e.g. https://founder-notes-bot.onrender.com
WEBHOOK_URL=https://your-app-name.onrender.com

# Port (Render sets this automatically — use 10000 for Render free tier)
PORT=10000
